{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "release:build": "npm run clean && vite build",
    "preview": "vite preview",
    "test": "node --test --test-timeout=10000 \"tests/**/*.test.mjs\"",
    "test:mount": "vitest run",
    "test:all": "npm test && npm run test:mount",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "marked": "^18.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
