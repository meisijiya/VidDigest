# VidDigest 后端环境变量模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ════════════════════════════════════════════════════════════
# AI 服务（必填）
# ════════════════════════════════════════════════════════════
#
# 平台只配一家：**阿里云百炼**。没有兜底链 —— provider 失败直接报错，
# 不切第二个后端（兜底会把第一个的真实错误盖住，工单 #107）。
# 但**协议**是开放的：百炼既提供 OpenAI 兼容模式，也提供 Anthropic
# Messages API 模式，换协议只改 ALIYUN_BAILIAN_PROTOCOL，不改代码。

# ── 阿里云百炼 ─────────────────────────────────────────
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
ALIYUN_BAILIAN_API_KEY=
# 端点（用你的 workspace 专属地址，形如
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1）
ALIYUN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 接口协议：openai（默认）或 anthropic。填 anthropic 时请求走
# Anthropic Messages API（/v1/messages + SSE），不引新依赖。
ALIYUN_BAILIAN_PROTOCOL=openai
# 是否开启模型的「混合思考」：false（默认，显式关闭）/ true / omit（不传）。
# qwen3.7-flash 默认开着思考，会返回 reasoning_content 并吃掉 max_tokens 预算
# （实测同一问句 845 vs 47 tokens）—— 平台路径默认关掉。
ALIYUN_BAILIAN_ENABLE_THINKING=false
# 模型选项（按价格从低到高）：
#   qwen3.7-flash   ≤32k 输入 0.2 元/M、输出 0.8 元/M   ← 平台默认用的它
#   qwen-plus       性价比更高
#   qwen-max        旗舰
#   qwen-long       长上下文专用
#
# ⚠️ 下面这行是**显式选择**，不是程序默认值：留空才轮到模型清单表里的
# bailian.default_model（表里没配时回落 qwen3.7-flash，见 backend/summarizer.py）。
# 写死在这里会盖住后台改的默认模型 —— 想「跟着平台走」就把这行清空。
# ⚠️ 模型名必须与**端点**匹配：同一个 workspace 端点上只有控制台里开通的模型可用，
# 填了端点上没有的名字会报 model_not_found。
ALIYUN_BAILIAN_MODEL=qwen3.7-flash

# ════════════════════════════════════════════════════════════
# 安全（强烈建议改）
# ════════════════════════════════════════════════════════════

# ── 安全（必填）────────────────────────────
# JWT_SECRET 没有兜底默认值，而且**不能留空**：auth.py 在 import 阶段就检查，
# 缺失或纯空白直接抛错拒绝启动。
#
# 这里刻意留空而不是填一个「记得改」的示例值 —— 模板里放任何具体字符串，
# 就会被当默认值抄走，而写死的兜底常量等于让猜中它的人伪造任意管理员 token
# （ADR 0010）。要值就现生成：openssl rand -hex 32
JWT_SECRET=

# ════════════════════════════════════════════════════════════
# Whisper ASR 回退（可选，仅在视频无字幕时使用）
# ════════════════════════════════════════════════════════════
# 注意：这个 key **只**给字幕识别（Whisper），不给 LLM 总结。
# 总结用的 key 是上面那个 ALIYUN_BAILIAN_API_KEY。
OPENAI_API_KEY=

# ════════════════════════════════════════════════════════════
# Stripe 支付（当前不启用 —— 项目不做会员制）
# 前端入口已通过 frontend/src/config/features.js 的 MEMBERSHIP_ENABLED 关闭。
# 以下变量仅供将来恢复会员制时使用，保留配置位但无需填写。
# ════════════════════════════════════════════════════════════

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
# 支付成功跳转的前端地址（按实际部署填写）
FRONTEND_URL=http://localhost:5173

# ════════════════════════════════════════════════════════════
# 每日免费额度（可选，改完重启生效）
# ════════════════════════════════════════════════════════════
#
# 两个额度是**各自独立**的计数器，各自在次日 0 点（UTC）重置，互不影响：
#   解析额度 —— 产出总结 + 思维导图 + 标签，一次解析扣一次
#   对话额度 —— 针对视频追问，一问一答扣一次
# 不配置则用代码里的默认值（解析 3 次 / 对话 10 次）。
# 填非数字会退回默认值，不会让服务起不来。
#
# 注意：改这里只影响**默认值**。用户已消耗的次数存在数据库里，
# 改配置不会清零已用额度。

VIDDIGEST_DAILY_PARSE_LIMIT=3
VIDDIGEST_DAILY_CHAT_LIMIT=10

# ════════════════════════════════════════════════════════════
# 测试账号（可选，只有联调 / 压测 / 演示才需要）
# ════════════════════════════════════════════════════════════
# 这四项只给 docs/OPERATIONS.md §5.5 的联调脚本读，程序本身不消费。
# 留空 = 不提供测试账号，脚本会因缺变量而停下而不是静默用兜底值。
#
# 口令现生成，别复用任何真实密码：
#   TEST_USER_PASSWORD=$(openssl rand -base64 18)
#
# 为什么专门开这一节：**敏感值只走变量 + 配置文件，不进文档也不进源码。**
# `.env` 本身已被 .gitignore 挡住，但 .gitignore 是文件名级的 —— 它挡得住
# 这个文件，挡不住「把这里的口令抄进 docs/OPERATIONS.md」。本仓库出过一次，
# 所以除了这一节，还加了内容级扫描关卡（scripts/check_secrets.py，init.sh 第 4 关）。
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_VIP_EMAIL=
TEST_VIP_PASSWORD=
